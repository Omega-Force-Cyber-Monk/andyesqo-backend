# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (user/password/db = andyesqo)
DATABASE_URL="postgresql://andyesqo:andyesqo@localhost:5432/andyesqo?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Generate a separate random key and keep it stable; losing it invalidates enrolled authenticators.
TOTP_ENCRYPTION_KEY=change-me-to-a-separate-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30

BCRYPT_SALT_ROUNDS=10

# Comma separated front-end origins, or * during development
CORS_ORIGINS=*

# Front-end base URL used in invitation / reset-password links
APP_URL=http://localhost:5173

# SMTP_URL and MAIL_FROM are required in production. Without SMTP in development,
# messages are saved as local .eml files (treat these files as secrets).
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM=Andyesqo <no-reply@example.com>
MAIL_DIRECTORY=var/mail

# Private folder for uploaded photos and documents (served only via the authenticated /api/v1/uploads API)
UPLOAD_DIR=uploads

# Used only by `npm run db:seed` (demo accounts get this password)
SEED_PASSWORD=Password123

# Driver GPS history is purged after this many days (daily job)
LOCATION_RETENTION_DAYS=90

# Requests per minute per client IP to each auth endpoint (login, password reset, MFA)
AUTH_RATE_LIMIT=10
# Set when behind a proxy/load balancer so the real client IP is used, e.g. 1
# TRUST_PROXY=1
